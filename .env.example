# PostgreSQL на хостинге (Timeweb, Supabase, Railway и т.д.)
DATABASE_URL=postgresql://user:password@host:5432/audioswipe

# SSL для облачных БД (часто нужен)
# DATABASE_SSL=true

JWT_SECRET=замени-на-длинную-случайную-строку
PORT=3001

# Фронтенд (Vercel) — для CORS на бэкенде
# CORS_ORIGIN=https://audioswipe.vercel.app

# URL API для фронтенда (если не задан — используется Render)
# VITE_API_URL=https://audioswipe.onrender.com/api
