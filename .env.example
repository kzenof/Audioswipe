# PostgreSQL (Supabase / Neon / Railway и т.д.)
DATABASE_URL=postgresql://user:password@host:5432/audioswipe

# SSL для облачных БД
DATABASE_SSL=true

JWT_SECRET=замени-на-длинную-случайную-строку
PORT=3001

# Фронтенд — для CORS, если API вызывают с другого домена
# CORS_ORIGIN=https://audioswipe.vercel.app

# URL API для фронтенда — на Vercel оставь пустым или /api (тот же домен)
# VITE_API_URL=/api
#
# Стрим Яндекса идёт на /ym-stream того же домена (rewrite в vercel.json).
# YANDEX_MUSIC_TOKEN задаётся в Vercel Environment Variables (не Render).

# Прокси Яндекс Музыки в РФ.
# Вариант без API Gateway — прямая ссылка Cloud Function:
# VITE_YM_BASE=https://functions.yandexcloud.net/d4egcugjrplf54p37gbj
#
# Вариант с API Gateway (если заведётся):
# VITE_YM_BASE=https://xxxxx.apigw.yandexcloud.net

# OAuth-токен Яндекс Музыки — без него download-info отвечает no-rights и стрим молчит
# Получить: https://oauth.yandex.ru/authorize?response_type=token&client_id=23cabbbdc6cd418abb4b39c32c41195d
# YANDEX_MUSIC_TOKEN=AQAAAAA...
